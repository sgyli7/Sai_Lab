# Frozen original ARM64 PhysX/RTX build. Build from the Sai_Lab repository root.
FROM nvcr.io/nvidia/isaac-sim@sha256:9bc527c60c1cdde532b05859b955e866e6115ac5bf2fe22eaa24daa6ea8783e6
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git gcc g++ make ffmpeg && rm -rf /var/lib/apt/lists/*
COPY upstream/unitree_g1/isaaclab_static /workspace/IsaacLab
COPY upstream/unitree_g1/isaaclab_arena_static /workspace/Arena
RUN ln -s /isaac-sim /workspace/IsaacLab/_isaac_sim
RUN printf '%s\n' 'torch==2.10.0+cu128' 'numpy==2.3.1' 'warp-lang==1.12.0' 'gymnasium==1.2.1' 'pillow==12.1.1' 'transformers==4.57.6' 'onnxruntime==1.26.0' 'setuptools<82' > /workspace/constraints.txt
RUN /isaac-sim/python.sh -m pip install --constraint /workspace/constraints.txt 'setuptools<82' wheel toml && \
    for directory in /workspace/IsaacLab/source/isaaclab*/; do /isaac-sim/python.sh -m pip install --no-deps --no-build-isolation -e "$directory"; done && \
    /isaac-sim/python.sh -m pip install --no-deps --no-build-isolation -e /workspace/Arena
# This reproduces prepare/resume_dependencies.sh from the successful 2026-10-02
# source runtime, preserving its Torch, Warp, gymnasium and image libraries.
RUN /isaac-sim/python.sh -m pip install --constraint /workspace/constraints.txt \
    onnxruntime==1.26.0 warp-lang==1.12.0 gymnasium==1.2.1 prettytable==3.3.0 \
    flatdict==4.0.0 rich hydra-core==1.3.2 pyquaternion onnx pin-pink==3.1.0 \
    daqp==0.7.2 'typing_extensions>=4.14' 'numba>=0.63.1' h5py tensorboard \
    lazy_loader einops transformers==4.57.6 pillow==12.1.1 lightwheel-sdk==1.0.3 \
    'vuer[all]==0.1.6' 'isaacteleop~=1.1.0' rsl-rl-lib==5.0.1 'onnxscript>=0.5' \
    pytest pyzmq==27.1.0 imageio-ffmpeg --extra-index-url https://pypi.nvidia.com
ENV ACCEPT_EULA=Y
ENV PRIVACY_CONSENT=Y
ENV ISAACLAB_PATH=/workspace/IsaacLab
ENV OMNI_KIT_ALLOW_ROOT=1
ENV PYTHONPATH=/home/ethan/Projects/Sai_Lab
WORKDIR /home/ethan/Projects/Sai_Lab
ENTRYPOINT ["/isaac-sim/python.sh"]
