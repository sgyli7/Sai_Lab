.venv/
**/__pycache__/
*.pyc
MUJOCO_LOG.TXT
.env
*.egg-info/
.pytest_cache/
.ruff_cache/

# Godot local
godot/.godot/
godot/generated/

# Forest vendor (clone with godot/scripts/setup_forest_vendor.sh)
godot/vendor/
godot/scenery
godot/textures
godot/materials
godot/grass
godot/levels
godot/objects
godot/forest_generated
godot/addons/

# Gate artifacts
results/

# Drop-in policies (do not commit ONNX / weights)
policies/**
!policies/.gitkeep
*.onnx

# training runs
logs/

# local scratch / Godot editor
*.uid
/bundles/
/runtime/
/.tmp/
/.cache/
/.config/
/.data/
# Derived third-party meshes remain local; the generator is published instead.
godot/atelier/robot_normals/
godot/atelier/robot_normals_soft/
/tmp_*.py
/shots/

# Native inference dependencies, build products, and generated release inputs
.venv-sai/
.venv-native/
native/.deps/
native/build/
native/build-release/
godot/native/bin/
godot/runtime_assets/
dist/

# Local planning scratch; durable findings belong in docs/ and CONTEXT.md.
.scratch/

# Match local asset links as well as directories.
godot/generated
godot/native/bin
godot/runtime_assets
godot/atelier/robot_normals
godot/atelier/robot_normals_soft

# Accepted default walking/sprint assets are shipped with the Python package.
!src/sim2sim/assets/microduck_sprint_v1/Walk_Godot.onnx
!src/sim2sim/assets/microduck_sprint_v1/Sprint_Godot.onnx
!src/sim2sim/assets/sai/upstream/flat-v1.onnx
!src/sim2sim/assets/sai/upstream/stairs-dev40.onnx
!src/sim2sim/assets/sai/upstream/experimental/ascent60.onnx
!src/sim2sim/assets/sai/upstream/experimental/descent60.onnx
