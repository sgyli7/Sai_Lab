{
  "name": "microduck",
  "mjcf": "${MICRODUCK_RL}/src/mjlab_microduck/robot/microduck/scene.xml",
  "godot_spec": "${SIM2SIM_ROOT}/godot/generated/microduck/robot_spec.json",
  "base_body": "trunk_base",
  "timestep": 0.005,
  "decimation": 4,
  "action_scale": 1.0,
  "current_limit_a": 1.75,
  "reset_z": 0.125,
  "home": [0.0, -0.0873, -0.4579, -0.0049, 0.4530, 0.3491, 0.3491, 0.0, 0.0, 0.0, 0.0873, 0.4579, 0.0049, -0.4530],
  "policies": {
    "alpha_walking": "${MICRODUCK_POLICIES}/alpha_walking.onnx",
    "local_ppo": "${MICRODUCK_POLICIES}/local-ppo/local_velocity_walk_run_idle.onnx",
    "walk_godot": "${MICRODUCK_POLICIES}/Walk_Godot.onnx"
  },
  "schedule": [
    {"name": "idle", "seconds": 2.0, "vel": [0.0, 0.0, 0.0]},
